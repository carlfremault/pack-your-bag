{
  "extends": "@repo/typescript-config/nestjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "dist",
    "paths": {
      "@/*": ["./src/*"]
    },
    "noEmit": false,
    "types": ["node"]
  },
  "include": [
    "src/**/*",
    "scripts/**/*",
    "test/**/*",
    "prisma/**/*.mts",
    "vitest.config.ts",
    "prisma.config.mts"
  ],
  "exclude": ["dist", "node_modules"]
}
