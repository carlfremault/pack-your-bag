                "$ref": "#/components/schemas/AuthForgotPasswordDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Reset email sent if the address is registered. Response is identical either way to prevent user enumeration."
          },
          "400": {
            "description": "Validation failed."
          },
          "401": {
            "description": "Missing or invalid BFF secret."
          },
          "429": {
            "description": "Rate limit exceeded."
          }
        },
        "security": [
          {
            "bff-secret": []
          }
        ],
        "summary": "Request a password reset email",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/reset-password": {
      "post": {
        "operationId": "AuthController_resetPassword",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthResetPasswordDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Password reset successfully."
          },
          "400": {
            "description": "Token invalid, expired, or already used."
          },
          "401": {
            "description": "Missing or invalid BFF secret."
          },
          "429": {
            "description": "Rate limit exceeded."
          }
        },
        "security": [
          {
            "bff-secret": []
          }
        ],
        "summary": "Reset password using a token from the reset email",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/verify-email": {
      "post": {
        "operationId": "AuthController_verifyEmail",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthVerifyEmailDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Email verified successfully."
          },
          "400": {
            "description": "Token invalid, expired, or already used."
          },
          "401": {
            "description": "Missing or invalid BFF secret."
          },
          "429": {
            "description": "Rate limit exceeded."
          }
        },
        "security": [
          {
            "bff-secret": []
          }
        ],
        "summary": "Verify email address using a token from the verification email",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/resend-verification-email": {
      "post": {
        "operationId": "AuthController_resendVerificationEmail",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthResendVerificationEmailDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Verification email resent if the address is registered and unverified. Response is identical either way to prevent user enumeration."
          },
          "400": {
            "description": "Validation failed."
          },
          "401": {
            "description": "Missing or invalid BFF secret."
          },
          "429": {
            "description": "Rate limit exceeded."
          }
        },
        "security": [
          {
            "bff-secret": []
          }
        ],
        "summary": "Resend verification email",
        "tags": [
          "auth"
        ]
      }
    },
    "/user/delete": {
      "post": {
