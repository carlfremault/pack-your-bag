{
  "openapi": "3.0.0",
  "paths": {
    "/auth/guest-session": {
      "post": {
        "operationId": "AuthController_createGuestSession",
        "parameters": [],
        "responses": {
          "201": {
            "description": "Guest session created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid BFF secret."
          },
          "429": {
            "description": "Rate limit exceeded."
          }
        },
        "security": [
          {
            "bff-secret": []
          }
        ],
        "summary": "Create a guest session with pre-seeded sample data",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/register": {
      "post": {
        "operationId": "AuthController_register",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthCredentialsDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "User registered and verification email sent."
          },
          "400": {
            "description": "Validation failed."
          },
          "401": {
            "description": "Missing or invalid BFF secret."
          },
          "409": {
            "description": "Email already in use."
          },
          "429": {
            "description": "Rate limit exceeded."
          }
        },
        "security": [
          {
            "bff-secret": []
          }
        ],
        "summary": "Register a new user and send verification email",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthCredentialsDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User logged in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed."
          },
          "401": {
            "description": "Invalid email or password."
          },
          "403": {
            "description": "Email not verified."
          },
          "429": {
            "description": "Rate limit exceeded."
          }
        },
        "security": [
          {
            "bff-secret": []
          }
        ],
        "summary": "Authenticate a user and issue tokens",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/refresh-token": {
      "post": {
        "operationId": "AuthController_refreshToken",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Tokens refreshed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or expired refresh token."
          },
          "429": {
            "description": "Rate limit exceeded."
          }
        },
        "security": [
          {
            "bff-secret": [],
            "refresh-token": []
          }
        ],
        "summary": "Rotate refresh token and issue new access token",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/logout": {
      "delete": {
        "operationId": "AuthController_logout",
        "parameters": [],
        "responses": {
          "204": {
            "description": "Logged out successfully."
          },
          "401": {
            "description": "Invalid or expired refresh token."
          },
          "429": {
            "description": "Rate limit exceeded."
          }
        },
        "security": [
          {
            "bff-secret": [],
            "refresh-token": []
          }
        ],
        "summary": "Revoke the current refresh token family (single device logout)",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/logout-all": {
      "delete": {
        "operationId": "AuthController_logoutAllDevices",
        "parameters": [],
        "responses": {
          "204": {
            "description": "All sessions revoked."
          },
          "401": {
            "description": "Invalid or expired access token."
          },
          "429": {
            "description": "Rate limit exceeded."
          }
        },
        "security": [
          {
            "bff-secret": [],
            "access-token": []
          }
        ],
        "summary": "Revoke all refresh tokens for the user (all devices logout)",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/update-password": {
      "patch": {
        "operationId": "AuthController_updatePassword",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdatePasswordDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password updated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed."
          },
          "401": {
            "description": "Invalid or expired access token."
          },
          "429": {
            "description": "Rate limit exceeded."
          }
        },
        "security": [
          {
            "bff-secret": [],
            "access-token": []
          }
        ],
        "summary": "Update password and re-issue tokens (invalidates all other sessions)",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/forgot-password": {
      "post": {
        "operationId": "AuthController_forgotPassword",
        "parameters": [],
        "requestBody": {
          "required": true,
