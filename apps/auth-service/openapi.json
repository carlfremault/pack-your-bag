        "security": [
          {
            "bff-secret": [],
            "access-token": []
          }
        ],
        "summary": "Request account deletion — account is permanently removed after a grace period",
        "tags": [
          "user"
        ]
      }
    },
    "/user/cancel-deletion": {
      "post": {
        "operationId": "UserController_cancelAccountDeletion",
