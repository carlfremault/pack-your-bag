{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "TRUST_PROXY",
    "BFF_SHARED_SECRET",
    "FRONTEND_URL",
    "AUTH_URL",
    "PRODUCT_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "^generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["AUTH_*", "RSA_*"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "dependsOn": ["^generate"],
      "cache": false,
      "persistent": true,
      "env": ["AUTH_*", "RSA_*"]
    },
    "test:setup": {
      "dependsOn": ["transit", "^generate"],
      "env": ["AUTH_*", "RSA_*"],
      "cache": true,
      "inputs": ["../../packages/db/prisma/schema.prisma", "../../packages/db/prisma/seed.mts"]
    },
    "test": {
      "dependsOn": ["test:setup"],
      "env": ["AUTH_*", "RSA_*"]
    },
    "test:watch": {
      "dependsOn": ["test:setup"],
      "cache": false,
      "persistent": true,
      "env": ["AUTH_*", "RSA_*"]
    },
    "test:browser": {
      "cache": false,
      "persistent": true
    },
    "migrate": {
      "cache": false,
      "inputs": ["prisma/schema.prisma", "prisma/migrations/**"],
      "env": ["AUTH_URL", "PRODUCT_URL"]
    },
    "status": {
      "cache": false,
      "inputs": ["prisma/schema.prisma", "prisma/migrations/**"],
      "env": ["AUTH_URL", "PRODUCT_URL"]
    },
    "generate": {
      "cache": false,
      "inputs": ["prisma/schema.prisma"],
      "outputs": ["generated/prisma/**"]
    },

    "deploy": {
      "cache": false,
      "inputs": ["prisma/schema.prisma", "prisma/migrations/**"],
      "env": ["AUTH_URL", "PRODUCT_URL"]
    },
    "seed": {
      "cache": false,
      "dependsOn": ["generate"],
      "inputs": ["prisma/schema.prisma", "prisma/seed.mts"],
      "env": ["AUTH_*"]
    },
    "openapi": {
      "dependsOn": ["build"],
      "inputs": ["src/**/*.ts", "scripts/generate-spec.ts"],
      "outputs": ["openapi.json"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    }
  }
}
