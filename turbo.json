{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "TRUST_PROXY",
    "BFF_SHARED_SECRET",
    "INTERNAL_SERVICE_SECRET",
    "FRONTEND_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "^generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "storybook-static/**"],
      "env": [
        "AUTH_*",
        "AUDIT_*",
        "PRODUCT_*",
        "USER_DATA_*",
        "UDS_*",
        "RSA_*",
        "NEXT_PUBLIC_*",
        "POSTGRES_*",
        "MONGO_*"
      ]
    },
    "lint": {
      "dependsOn": ["^lint", "^build", "^generate"]
    },
    "check-types": {
      "dependsOn": ["^check-types", "^build", "^generate"]
    },
    "dev": {
      "dependsOn": ["^build", "^generate"],
      "cache": false,
      "persistent": true,
      "env": [
        "AUTH_*",
        "AUDIT_*",
        "PRODUCT_*",
        "USER_DATA_*",
        "UDS_*",
        "RSA_*",
        "NEXT_PUBLIC_*",
        "DEV_SENTRY_DSN",
        "POSTGRES_*",
        "MONGO_*"
      ]
    },
    "test:setup": {
      "dependsOn": ["transit"],
      "env": ["AUTH_*", "RSA_*", "POSTGRES_*"],
      "cache": false,
      "inputs": ["../../packages/db/prisma/schema.prisma", "../../packages/db/prisma/seed.mts"]
    },
    "test": {
      "dependsOn": ["test:setup", "^build"],
      "env": [
        "AUTH_*",
        "AUDIT_*",
        "PRODUCT_*",
        "USER_DATA_*",
        "UDS_*",
        "RSA_*",
        "NEXT_PUBLIC_*",
        "POSTGRES_*",
        "MONGO_*"
      ]
    },
    "test:watch": {
      "dependsOn": ["test:setup", "^build"],
      "cache": false,
      "persistent": true,
      "env": [
        "AUTH_*",
        "AUDIT_*",
        "PRODUCT_*",
        "USER_DATA_*",
        "UDS_*",
        "RSA_*",
        "NEXT_PUBLIC_*",
        "POSTGRES_*",
        "MONGO_*"
      ]
    },
    "test:browser": {
      "cache": false,
      "persistent": true
    },
    "migrate": {
      "cache": false,
      "inputs": ["prisma/schema.prisma", "prisma/migrations/**"],
      "env": ["POSTGRES_*"]
    },
    "status": {
      "cache": false,
      "inputs": ["prisma/schema.prisma", "prisma/migrations/**"],
      "env": ["POSTGRES_*"]
    },
    "generate": {
      "cache": false,
      "inputs": ["prisma/schema.prisma", "prisma/migrations/**"],
      "outputs": ["generated/prisma/**"],
      "env": ["POSTGRES_*"]
    },

    "deploy": {
      "cache": false,
      "inputs": ["prisma/schema.prisma", "prisma/migrations/**"],
      "env": ["POSTGRES_*"]
    },
    "seed": {
      "cache": false,
      "dependsOn": ["generate"],
      "inputs": ["prisma/schema.prisma", "prisma/seed.mts"],
      "env": ["POSTGRES_*"]
    },
    "generate:client": {
      "cache": false,
      "inputs": ["../../apps/*/openapi.json", "scripts/**"],
      "outputs": ["src/schema.d.ts", "src/schema.zod.ts"]
    },
    "openapi": {
      "dependsOn": ["build"],
      "inputs": ["src/**/*.ts", "scripts/generate-spec.ts"],
      "outputs": ["openapi.json"]
    },
    "storybook": {
      "cache": false,
      "persistent": true,
      "outputs": ["storybook-static/**"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    }
  }
}
