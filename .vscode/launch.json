{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "attach",
      "name": "Debug: Web (NextJS)",
      "port": 9233,
      "restart": true,
      "localRoot": "${workspaceFolder}/apps/web",
      "remoteRoot": "/workspaces/pack-your-bag/apps/web",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Debug: Auth Service",
      "port": 9230,
      "restart": true,
      "localRoot": "${workspaceFolder}/apps/auth-service",
      "remoteRoot": "/workspaces/pack-your-bag/apps/auth-service",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Debug: Product Service",
      "port": 9231,
      "restart": true,
      "localRoot": "${workspaceFolder}/apps/product-service",
      "remoteRoot": "/workspaces/pack-your-bag/apps/product-service",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
