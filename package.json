{
  "name": "pack-your-bag",
  "private": true,
  "scripts": {
    "build": "cross-env NODE_ENV=production turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "check-types": "turbo run check-types",
    "test:setup": "cross-env NODE_ENV=test dotenv -e .env.test -o -- turbo run test:setup",
    "test": "cross-env NODE_ENV=test dotenv -e .env.test -o -- turbo run test",
    "test:watch": "cross-env NODE_ENV=test dotenv -e .env.test -o -- turbo run test:watch",
    "test:browser": "turbo run test:browser",
    "view-report": "turbo run view-report",
    "prepare": "husky",
    "pre-commit": "turbo run lint --filter=[{staged}] && lint-staged",
    "db:init": "node --experimental-strip-types scripts/database-setup.ts",
    "db:init:test": "cross-env NODE_ENV=test node --experimental-strip-types scripts/database-setup.ts",
    "db:generate": "dotenv -e .env -o -- turbo run generate --filter=@repo/db",
    "db:migrate": "dotenv -e .env -o -- turbo run migrate --filter=@repo/db",
    "db:status": "dotenv -e .env -o -- turbo run status --filter=@repo/db",
    "db:deploy": "dotenv -e .env -o -- turbo run deploy --filter=@repo/db",
    "db:seed": "dotenv -e .env -o -- turbo run seed --filter=@repo/db",
    "openapi:auth": "turbo run openapi --filter=auth-service",
    "openapi:product": "turbo run openapi --filter=product-service",
    "openapi:user-data": "turbo run openapi --filter=user-data-service",
    "generate:auth-client": "yarn workspace @repo/auth-client generate",
    "generate:product-client": "yarn workspace @repo/product-client generate",
    "generate:user-data-client": "yarn workspace @repo/user-data-client generate",
    "storybook": "turbo run storybook"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/pg": "^8.16.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^11.0.0",
    "dotenv-expand": "^12.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "pg": "^8.16.3",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.6.2",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@4.11.0",
  "resolutions": {
    "zod": "4.3.6"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "typescript-eslint": "^8.59.2"
  }
}
