NODE_ENV=test
FRONTEND_URL=http://localhost:3000

# POSTGRES
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres_db
POSTGRES_PORT=5432

POSTGRES_DB=packyourbag
POSTGRES_ADMIN_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

POSTGRES_TEST_DB=packyourbag_test
POSTGRES_ADMIN_TEST_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_TEST_DB}?schema=public"

# AUTH DATABASE
POSTGRES_AUTH_USER=postgres_auth
POSTGRES_AUTH_PASSWORD=postgres_auth
POSTGRES_AUTH_SCHEMA=app_auth
POSTGRES_AUTH_URL="postgresql://${POSTGRES_AUTH_USER}:${POSTGRES_AUTH_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_TEST_DB}?schema=${POSTGRES_AUTH_SCHEMA}"

# AUDIT DATABASE
POSTGRES_AUDIT_USER=postgres_audit
POSTGRES_AUDIT_PASSWORD=postgres_audit
POSTGRES_AUDIT_SCHEMA=app_audit
POSTGRES_AUDIT_URL="postgresql://${POSTGRES_AUDIT_USER}:${POSTGRES_AUDIT_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_TEST_DB}?schema=${POSTGRES_AUDIT_SCHEMA}"

# PRODUCT DATABASE
POSTGRES_PRODUCT_USER=postgres_product
POSTGRES_PRODUCT_PASSWORD=postgres_product
POSTGRES_PRODUCT_SCHEMA=app_product
POSTGRES_PRODUCT_URL="postgresql://${POSTGRES_PRODUCT_USER}:${POSTGRES_PRODUCT_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_TEST_DB}?schema=${POSTGRES_PRODUCT_SCHEMA}"

# API CONFIGURATION
